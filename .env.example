# Copy this file to .env.local and fill in the values from the Neon console.
# Neon's Connect dialog shows both: turn "Connection pooling" on for the first, off for the second.

# Pooled connection, used by the app at runtime. The host contains "-pooler".
DATABASE_URL="postgresql://USER:PASSWORD@ep-example-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require"

# Direct connection, used by the Prisma CLI for migrations.
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@ep-example.REGION.aws.neon.tech/DBNAME?sslmode=require"

# Optional. Shown as the site title.
# NEXT_PUBLIC_APP_NAME="Golf Course"
