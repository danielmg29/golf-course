{
  "name": "golf-course",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "^22.18.0 || ^24.11.0 || >=26.0.0"
  },
  "scripts": {
    "schema": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "predev": "npm run schema",
    "dev": "next dev",
    "prebuild": "npm run schema",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "verify": "npm run schema && git diff --exit-code lib/generated/schema.ts && npm run typecheck && npm run test"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@prisma/adapter-neon": "7.10.1",
    "@prisma/client": "7.10.1",
